{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContractSchema",
  "type": "object",
  "properties": {
    "approval_response": {
      "$ref": "#/$defs/ApprovalResponding"
    },
    "approval_state": {
      "$ref": "#/$defs/ApprovalState"
    },
    "client_scope": {
      "$ref": "#/$defs/ClientScope"
    },
    "event": {
      "$ref": "#/$defs/DurableEvent"
    },
    "option_class": {
      "$ref": "#/$defs/OptionClass"
    },
    "session_lifecycle": {
      "$ref": "#/$defs/SessionLifecycle"
    }
  },
  "required": [
    "event",
    "approval_response",
    "approval_state",
    "session_lifecycle",
    "option_class",
    "client_scope"
  ],
  "$defs": {
    "ApprovalDecision": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "cancel"
      ]
    },
    "ApprovalResponding": {
      "type": "object",
      "properties": {
        "approval_id": {
          "type": "string",
          "format": "uuid"
        },
        "client_scope": {
          "$ref": "#/$defs/ClientScope"
        },
        "decision": {
          "$ref": "#/$defs/ApprovalDecision"
        },
        "option_class": {
          "$ref": "#/$defs/OptionClass"
        },
        "option_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "responded_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "responder": {
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "decision",
        "responder",
        "responded_at_ms",
        "option_class",
        "client_scope"
      ]
    },
    "ApprovalState": {
      "type": "string",
      "enum": [
        "pending",
        "responding",
        "responded_unacked",
        "allowed",
        "denied",
        "expired",
        "withdrawn",
        "delivered_unconfirmed"
      ]
    },
    "ClientScope": {
      "type": "string",
      "enum": [
        "full",
        "limited"
      ]
    },
    "DurableEvent": {
      "type": "object",
      "properties": {
        "causation": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_id": {
          "type": "integer",
          "format": "int64"
        },
        "host_id": {
          "type": "string",
          "format": "uuid"
        },
        "journal_epoch": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string"
        },
        "occurred_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "payload": true,
        "provider_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "redaction_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "event_id",
        "journal_epoch",
        "host_id",
        "session_id",
        "schema_version",
        "kind",
        "occurred_at_ms",
        "redaction_flags",
        "payload"
      ]
    },
    "OptionClass": {
      "type": "string",
      "enum": [
        "once",
        "widening",
        "boundary_breaking"
      ]
    },
    "SessionLifecycle": {
      "type": "string",
      "enum": [
        "open",
        "closing",
        "closed",
        "purging",
        "purged"
      ]
    }
  }
}
